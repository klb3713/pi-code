{
  "name": "Pi Code",
  "id": "dev.picode.app",
  "version": "0.1.0",
  "build": 1,
  "appearance": "dark",
  "theme": "theme.json",
  "tailwind": {
    "fontFamily": {
      "sans": "system-ui",
      "mono": "Menlo"
    },
    "radius": {
      "card": 12,
      "panel": 10
    },
    "colors": {
      "surface": "#181816",
      "surface-raised": "#20201c",
      "code": "#171714",
      "code-foreground": "#d8d4cb",
      "success": "#56b46a",
      "warning": "#d6a33f",
      "info": "#6aa9f5"
    }
  },
  "capabilities": {
    "process": {
      "execute": [
        "node"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "GEMINI_API_KEY",
        "DEEPSEEK_API_KEY",
        "OPENROUTER_API_KEY",
        "GROQ_API_KEY",
        "XAI_API_KEY",
        "MISTRAL_API_KEY",
        "ZAI_API_KEY",
        "KIMI_API_KEY",
        "MINIMAX_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_MODEL"
      ]
    },
    "fs": {
      "read": [
        "${pluginDir}",
        "${dataDir}",
        "${homeDir}"
      ],
      "write": [
        "${pluginDir}",
        "${dataDir}",
        "${homeDir}"
      ]
    }
  },
  "icon": "assets/icon.png"
}