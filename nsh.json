{
  "name": "Pi Code",
  "id": "dev.picode.app",
  "version": "0.1.0",
  "build": 1,
  "appearance": "dark",
  "theme": "theme.json",
  "tailwind": {
    "fontFamily": {
      "sans": "system-ui",
      "mono": "Menlo"
    },
    "radius": {
      "card": 12,
      "panel": 10
    }
  },
  "capabilities": {
    "network": {
      "http": [
        {
          "host": "127.0.0.1",
          "port": 8787,
          "schemes": ["http", "ws"],
          "methods": ["GET"],
          "paths": ["/bridge"]
        }
      ]
    },
    "process": {
      "execute": [
        "node"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "OPENAI_API_KEY",
        "GEMINI_API_KEY",
        "DEEPSEEK_API_KEY",
        "OPENROUTER_API_KEY",
        "GROQ_API_KEY",
        "XAI_API_KEY",
        "MISTRAL_API_KEY",
        "ZAI_API_KEY",
        "KIMI_API_KEY",
        "MINIMAX_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_MODEL",
        "PI_CODE_CONFIG_DIR"
      ]
    },
    "fs": {
      "read": [
        "${pluginDir}",
        "${dataDir}",
        "${homeDir}"
      ],
      "write": [
        "${pluginDir}",
        "${dataDir}",
        "${homeDir}"
      ]
    }
  },
  "icon": "assets/icon.png"
}
